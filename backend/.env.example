# Doctor & Clinic Management System (DoctorMS)
# Environment Configuration

PROJECT_NAME="DoctorMS API"
ENVIRONMENT="development"
DEBUG=true

# Security & Authentication
SECRET_KEY="replace-with-a-very-secure-random-secret-key-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="doctorms_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_secure_password@localhost:5432/doctorms_db"

# Redis (Caching & Real-Time Queue PubSub)
REDIS_URL="redis://localhost:6379/0"

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
